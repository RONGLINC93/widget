#!/bin/bash
# 目录浏览器 - 启停管理脚本（零依赖，标准库 http.server）
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
APP_DIR="${TRIM_APPDEST:-$(dirname -- "${SCRIPT_DIR}")}"
PKGVAR_DIR="${TRIM_PKGVAR:-${APP_DIR}/var}"
TEMP_LOG_FILE="${TRIM_TEMP_LOGFILE:-/tmp/com.dirwidget.log}"
PID_FILE="${PKGVAR_DIR}/app.pid"
LOG_FILE="${PKGVAR_DIR}/app.log"
SERVICE_PORT="${TRIM_SERVICE_PORT:-8099}"
APP_MODULE="${APP_DIR}/server.py"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "${LOG_FILE}"; }

check_process() { local pid="$1"; kill -0 "${pid}" 2>/dev/null; }

status_process() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
        if [ -n "${pid}" ] && check_process "${pid}"; then return 0; fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

case "$1" in
    start)
        if status_process; then exit 0; fi
        mkdir -p "${PKGVAR_DIR}"

        command -v python3 >/dev/null 2>&1 || {
            echo "未找到 python3 运行时" > "${TEMP_LOG_FILE}"; exit 1; }

        cd "${APP_DIR}" || { echo "应用目录不存在：${APP_DIR}" > "${TEMP_LOG_FILE}"; exit 1; }
        log "启动目录浏览器，Port ${SERVICE_PORT}"
        SERVICE_PORT="${SERVICE_PORT}" BIND_HOST="0.0.0.0" \
            nohup python3 "${APP_MODULE}" >> "${LOG_FILE}" 2>&1 &
        echo $! > "${PID_FILE}"

        for i in $(seq 1 20); do
            if curl -sf "http://127.0.0.1:${SERVICE_PORT}/health" >/dev/null 2>&1; then
                log "服务启动成功"; exit 0
            fi
            sleep 1
        done

        pid="$(cat "${PID_FILE}" | tr -d '[:space:]')"
        if [ -n "${pid}" ] && check_process "${pid}"; then
            log "进程运行中但端口未就绪，继续等待"; exit 0
        fi
        echo "应用启动失败，请查看日志: ${LOG_FILE}" > "${TEMP_LOG_FILE}"
        rm -f "${PID_FILE}"
        exit 1
        ;;

    stop)
        if [ -f "${PID_FILE}" ]; then
            pid="$(cat "${PID_FILE}" | tr -d '[:space:]')"
            if [ -n "${pid}" ]; then
                kill "${pid}" 2>/dev/null
                for i in $(seq 1 10); do
                    check_process "${pid}" || break
                    sleep 1
                done
                kill -9 "${pid}" 2>/dev/null
            fi
            rm -f "${PID_FILE}"
        fi
        pkill -f "server.py" 2>/dev/null
        exit 0
        ;;

    status)
        if status_process; then exit 0; fi
        exit 3
        ;;

    *)
        echo "Usage: $0 {start|stop|status}"
        exit 1
        ;;
esac
